#!/bin/sh
# Runs mex under Node 24. On Node 26, node:sqlite throws ERR_OUT_OF_RANGE when an
# FTS5 contentless_delete table records a delete (its tombstone rowid is above
# 2^53), so `mex graph refresh` aborts. Node 22/24 accept it.
# Bug: https://github.com/mex-memory/mex/issues/320 (fix PR: https://github.com/mex-memory/mex/pull/348)
# REMOVE THIS FILE once an installed mex release contains the fix and
# `mex graph refresh` succeeds on Node 26 after a source change.
#
# The mex launcher runs a bare `node`, and `mise exec node@24` does not put Node 24
# ahead of /usr/bin/node for child processes, so Node 24's bin goes first in PATH.
node24=$(mise where node@24 2>/dev/null) || {
  echo "mex wrapper: Node 24 is not installed; run: mise install node@24" >&2
  exit 1
}
PATH="$node24/bin:$PATH" exec "$HOME/.local/share/mise/installs/npm-mex-agent/latest/node_modules/.bin/mex" "$@"
