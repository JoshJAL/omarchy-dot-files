#!/bin/bash
# keepawake-guard — prevent blanking/locking while the system is "busy".
#
# Holds an idle inhibit whenever EITHER:
#   * audio is actively playing on any PulseAudio/PipeWire sink, OR
#   * overall CPU usage is above a threshold (covers active terminal jobs:
#     builds, compiles, test runs, encodes, etc.)
#
# OMARCHY 4 (QUATTRO) NOTE — why this holds two different inhibits:
#
# Under Omarchy 3 this script only held a systemd idle inhibitor, because
# hypridle honored logind inhibitors. Quattro retired hypridle. Its replacement
# is a Quickshell service (shell/plugins/services/idle/Service.qml) whose
# IdleMonitor comes from Quickshell/Wayland/_IdleNotify — the Wayland
# ext-idle-notify protocol. Its `respectInhibitors: true` honors *Wayland*
# idle inhibitors, not logind ones, so a systemd inhibitor alone no longer
# stops the screensaver or the lock.
#
# What the Quattro service does gate on is its stay-awake state file, the same
# one `omarchy toggle idle` writes and the bar's indicator reflects. So:
#
#   * systemd inhibitor  -> still held, still prevents logind idle actions
#                           and suspend during long jobs.
#   * stay-awake state   -> what actually holds off Quattro's screensaver/lock.
#
# Expect the bar's stay-awake indicator to switch on by itself while the
# machine is busy. That is this script, and it is the visible signal that the
# guard is working.
#
# A manual toggle always wins: if stay-awake is already set when we go busy, we
# treat it as yours and never clear it. We only ever clear a state we set
# ourselves, tracked by a marker file in $XDG_RUNTIME_DIR (which the session
# clears on logout, so a marker found at startup means a previous run was
# killed and left the state set — we clean that up).
#
# NOTE: a command that is *running but using ~no CPU* (an idle dev server,
# a waiting SSH session, a paused REPL) cannot be distinguished from "nothing
# happening" and will NOT inhibit the lock. To force-keep-awake around such a
# command, wrap it:  systemd-inhibit --what=idle <your-command>
# ...or just flip the indicator yourself with `omarchy toggle idle stay-awake`.
#
# Tunables (env-overridable):
#   KEEPAWAKE_POLL          seconds between checks            (default 30)
#   KEEPAWAKE_CPU_THRESHOLD overall CPU %% that counts as busy (default 8)
#                           On this 20-core box ~8%% ≈ one fully-busy core.

POLL="${KEEPAWAKE_POLL:-30}"
CPU_THRESHOLD="${KEEPAWAKE_CPU_THRESHOLD:-8}"
WHO="keepawake-guard"

INHIBIT_PID=""
STAY_AWAKE_STATE="$HOME/.local/state/omarchy/indicators/stay-awake"
OWNED_MARKER="${XDG_RUNTIME_DIR:-/tmp}/keepawake-guard.owns-stay-awake"

# ---- single instance guard -------------------------------------------------
LOCKFILE="${XDG_RUNTIME_DIR:-/tmp}/keepawake-guard.lock"
exec 9>"$LOCKFILE"
if ! flock -n 9; then
    echo "keepawake-guard: already running" >&2
    exit 0
fi

# ---- cpu sampling ----------------------------------------------------------
cpu_snapshot() {
    # echoes "<total> <idle>" jiffies from /proc/stat aggregate cpu line
    awk '/^cpu /{idle=$5+$6; total=0; for(i=2;i<=NF;i++) total+=$i; print total, idle; exit}' /proc/stat
}

cpu_busy() {
    read -r t1 i1 < <(cpu_snapshot)
    sleep 1
    read -r t2 i2 < <(cpu_snapshot)
    local dt=$((t2 - t1)) di=$((i2 - i1))
    [ "$dt" -le 0 ] && return 1
    # busy% = 100 * (1 - idle_delta/total_delta)
    awk -v dt="$dt" -v di="$di" -v thr="$CPU_THRESHOLD" \
        'BEGIN { busy = 100 * (1 - di/dt); exit !(busy >= thr) }'
}

audio_playing() {
    pactl list sinks 2>/dev/null | grep -q 'State: RUNNING'
}

is_busy() {
    audio_playing && return 0
    cpu_busy && return 0
    return 1
}

# ---- systemd inhibitor (logind idle actions and suspend) -------------------
start_inhibit() {
    if [ -n "$INHIBIT_PID" ] && kill -0 "$INHIBIT_PID" 2>/dev/null; then
        return
    fi
    systemd-inhibit --what=idle --who="$WHO" --why="audio or CPU activity" \
        --mode=block sleep infinity &
    INHIBIT_PID=$!
}

stop_inhibit() {
    [ -n "$INHIBIT_PID" ] || return
    kill "$INHIBIT_PID" 2>/dev/null
    INHIBIT_PID=""
}

# ---- Quattro stay-awake state (screensaver and lock) -----------------------
stay_awake_set() { [ -f "$STAY_AWAKE_STATE" ]; }
we_own_stay_awake() { [ -f "$OWNED_MARKER" ]; }

start_stay_awake() {
    we_own_stay_awake && return
    # Already set by hand? Leave it alone; it is not ours to clear later.
    stay_awake_set && return
    omarchy-toggle-idle stay-awake >/dev/null 2>&1 && : >"$OWNED_MARKER"
}

stop_stay_awake() {
    we_own_stay_awake || return
    omarchy-toggle-idle allow-idle >/dev/null 2>&1
    rm -f "$OWNED_MARKER"
}

# A marker left over from a previous run means that run was killed before it
# could release the state. Clear it now so the machine cannot be stuck awake.
if we_own_stay_awake; then
    omarchy-toggle-idle allow-idle >/dev/null 2>&1
    rm -f "$OWNED_MARKER"
fi

cleanup() { stop_inhibit; stop_stay_awake; exit 0; }
trap cleanup TERM INT EXIT

# ---- main loop -------------------------------------------------------------
while true; do
    if is_busy; then
        start_inhibit
        start_stay_awake
    else
        stop_inhibit
        stop_stay_awake
    fi
    sleep "$POLL"
done
