#!/usr/bin/env python3
"""Validate/repair the plaintext GNOME keyring (raw newlines in secrets corrupt it)."""
import os, re, shutil, subprocess, sys, time
D = os.path.expanduser("~/.local/share/keyrings")
B = os.path.expanduser("~/.local/state/keyring-guard")
F = os.path.join(D, "Default_keyring.keyring")
LINE = re.compile(r"^(\[[^\]]+\]|[^=\[\]][^=]*=.*|)$")

def valid(lines):
    return lines and lines[0] == "[keyring]" and all(LINE.match(l) for l in lines)

def repair(lines):
    out, i = [], 0
    while i < len(lines):
        l = lines[i]
        if l.startswith("secret="):
            j = i + 1
            while j < len(lines) and not re.match(r"^(mtime|ctime)=\d+$", lines[j]):
                j += 1
            out.append("\\n".join(lines[i:j])); i = j
        else:
            out.append(l); i += 1
    return out

def main():
    if not os.path.exists(F): return
    raw = open(F, "rb").read()
    if not raw.startswith(b"[keyring]"): return  # encrypted/binary: nothing to do
    lines = raw.decode("utf-8", "replace").split("\n")
    if valid(lines):
        shutil.copy2(F, os.path.join(B, "last-good.keyring")); return
    stamp = time.strftime("%Y%m%d-%H%M%S")
    shutil.copy2(F, os.path.join(B, f"broken-{stamp}.keyring"))
    fixed = repair(lines)
    if not valid(fixed):
        subprocess.run(["notify-send", "-u", "critical", "keyring-guard", "Keyring corrupt and auto-repair failed. See ~/.local/state/keyring-guard"]); sys.exit(1)
    tmp = F + ".guard-tmp"
    open(tmp, "w").write("\n".join(fixed)); os.chmod(tmp, 0o600); os.replace(tmp, F)
    subprocess.run(["systemctl", "--user", "restart", "gnome-keyring-daemon.service"])
    subprocess.run(["notify-send", "keyring-guard", "Repaired corrupt keyring (newline in a secret) and restarted the daemon."])
    # keep only the 5 newest broken-* backups
    for f in sorted(x for x in os.listdir(B) if x.startswith("broken-"))[:-5]:
        os.remove(os.path.join(B, f))
main()
