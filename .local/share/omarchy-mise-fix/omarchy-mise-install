#!/bin/bash

# omarchy:summary=Install a small mise-backed wrapper for a given tool.
# omarchy:args=<package> [command-name [bin-name]]

if [[ -z $1 ]]; then
  echo "Usage: omarchy-mise-install <package> [command-name [bin-name]]"
  exit 1
fi

package=$1
command=${2:-$1}
bin=${3:-$command}

mkdir -p "$HOME/.local/bin"

# The wrapper must exec an ABSOLUTE path. Do not write
# `exec mise x "$package" -- "$bin"`: the inner name is re-resolved through the
# PATH mise builds, and that PATH puts ~/.local/bin ahead of the mise install
# dir -- so the wrapper re-enters itself forever for any caller whose
# environment lacks __MISE_DIFF (GUI apps, systemd units, Electron apps like
# T3 Code). An activated interactive shell short-circuits `mise x` and hides
# the bug, which is why this only ever shows up outside the terminal.
#
# These tools install and upgrade on first run, so mise's release cooldown would
# hold a new version back for days after it ships. MISE_MINIMUM_RELEASE_AGE is
# exported rather than set on the install line alone, so resolving the version
# to execute agrees with the one just installed.
rm -f "$HOME/.local/bin/$command"
cat >"$HOME/.local/bin/$command" <<EOF
#!/bin/bash
# mise-managed wrapper for \`$command\` (mise tool: $package).
# Generated by omarchy-mise-install. Execs an absolute path -- see that script
# for why \`mise x\` must not be used here.
set -u

tool='$package'
bin='$bin'
recheck_minutes=720            # look for a newer release at most twice a day

export MISE_MINIMUM_RELEASE_AGE=0
cache="\${XDG_CACHE_HOME:-\$HOME/.cache}/mise-wrappers/\$bin"

resolve() {
  mkdir -p "\${cache%/*}"
  mise use -g --quiet "\$tool" >/dev/null 2>&1 || true
  target=\$(mise which "\$bin" 2>/dev/null) || target=''
  [ -n "\$target" ] && [ -x "\$target" ] && printf '%s\n' "\$target" >"\$cache"
}

target=''
if [ -e "\$cache" ] && [ -z "\$(find "\$cache" -mmin +"\$recheck_minutes" 2>/dev/null)" ]; then
  target=\$(cat "\$cache")
fi
if [ -z "\$target" ] || [ ! -x "\$target" ]; then
  resolve
fi
if [ -z "\$target" ] || [ ! -x "\$target" ]; then
  printf '%s: mise could not resolve a binary for tool %s\n' "\$bin" "\$tool" >&2
  exit 127
fi

exec "\$target" "\$@"
EOF

chmod +x "$HOME/.local/bin/$command"
