# ~/.gitignore — work-tree of ~/.dotfiles is $HOME and the remote is PUBLIC.
#
# This file is DENY-BY-DEFAULT: everything in $HOME is ignored, and the
# un-ignore rules below name the paths this repo actually tracks. A stray
# `dotfiles add -A` therefore adds nothing it shouldn't, no matter what new
# tool drops a token in $HOME later.
#
# Rules live here rather than in ~/.dotfiles/info/exclude because this file is
# itself tracked, so a fresh clone on another machine is protected immediately.
#
# TO TRACK SOMETHING NEW:
#     dotfiles add -f <path>      # or: dotfiles-track <path>
# .gitignore only ever applies to UNTRACKED files, so once a file is added it
# stays tracked and keeps showing up in status/diff as normal. Adding a rule
# below is optional documentation, not a requirement.

# ---------------------------------------------------------------------------
# 1. Ignore everything.
# ---------------------------------------------------------------------------
/*

# ---------------------------------------------------------------------------
# 2. Re-admit the tracked tree.
#    A directory must be re-admitted before anything inside it can be.
# ---------------------------------------------------------------------------
!/.bashrc
!/.gitignore
!/README.md
!/NEW-MACHINE.md
!/hypr-quattro-port/

# --- ~/.config -------------------------------------------------------------
!/.config/
/.config/*
!/.config/alacritty/
!/.config/ghostty/
!/.config/kitty/
!/.config/git/
!/.config/mise/
!/.config/brave-flags.conf
!/.config/brave-origin-beta-flags.conf
!/.config/chrome-flags.conf
!/.config/chromium-flags.conf
!/.config/helium-browser-flags.conf
!/.config/mimeapps.list
!/.config/starship.toml
!/.config/xdg-terminals.list

# Hyprland: the .lua config is ours. The leftover .conf files from before the
# quattro port are kept on disk as reference but deliberately not tracked,
# except the two that are still live.
!/.config/hypr/
/.config/hypr/*.conf
!/.config/hypr/hyprsunset.conf
!/.config/hypr/xdph.conf

# Omarchy: our hooks, branding text and the taskbar plugin. Themes are each
# their own upstream repo (see themes-installed.txt), and `themed/`,
# `extensions/` and the shipped *.sample hooks are Omarchy's, not ours.
!/.config/omarchy/
/.config/omarchy/themes/
/.config/omarchy/themed/
/.config/omarchy/extensions/
/.config/omarchy/hooks/**/*.sample
/.config/omarchy/branding/about.txt
/.config/omarchy/branding/screensaver.txt
/.config/omarchy/plugins/*
!/.config/omarchy/plugins/joshjal.taskbar/

# --- ~/.local --------------------------------------------------------------
# ~/.local/bin also holds generated mise wrappers, so name our scripts rather
# than re-admitting the whole directory.
!/.local/
/.local/*
!/.local/bin/
/.local/bin/*
!/.local/bin/hypr-scratchpad-toggle
!/.local/bin/hypr-window-reset-size
!/.local/bin/keepawake-guard
!/.local/bin/omarchy-launch-screensaver
!/.local/bin/zed-launch
!/.local/share/
/.local/share/*
!/.local/share/omarchy-mise-fix/

# ---------------------------------------------------------------------------
# 3. Never, under any circumstances.
#    Last match wins in git, so these outrank every un-ignore rule above and
#    survive a future negation added carelessly.
# ---------------------------------------------------------------------------

# Secrets and key material
secrets.env
*.secrets
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.gpg
*.asc
*.kbx
id_rsa*
id_ecdsa*
id_ed25519*

# Anything that parks an auth token on disk
**/auth.json
**/credentials
**/credentials.*
**/.credentials.json
**/*token*.json
.npmrc
.netrc
.pypirc
.pgpass

# Vendor plugin caches. Version-pinned paths full of symlinks -- tracking them
# strands dead entries in the repo on the next plugin bump. Agent config lives
# in the private ~/.agentfiles repo instead.
.claude/plugins/cache/
.codex/plugins/

# Local backups and stray archives/logs
*.bak
*.bak.*
*.orig
*.rej
*~
*.tar.gz
*.tgz
*.zip
*.log
