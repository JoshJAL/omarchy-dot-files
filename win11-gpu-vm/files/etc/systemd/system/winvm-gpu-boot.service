# Reserve the passthrough GPU for the Windows VM at boot, before the login screen, so no desktop session
# ever opens it and starting Windows never needs a log out/in. Does nothing unless the Hyprland
# gpu-vm-mode flag is set (winvm-gpu on). Installed by the win11-gpu-vm bundle.
[Unit]
Description=Reserve the passthrough GPU for the Windows VM (winvm-gpu)
After=plymouth-quit.service systemd-modules-load.service
Before=display-manager.service
RequiresMountsFor=/home

[Service]
Type=oneshot
ExecStart=-/usr/local/bin/winvm-gpu boot
SyslogIdentifier=winvm-gpu

[Install]
WantedBy=graphical.target
