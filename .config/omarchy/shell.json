{
  "bar": {
    "layout": {
      "center": [
        {
          "format": "ddd d MMM h:mm AP",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "id": "omarchy.clock",
          "verticalFormat": "h\n\u2014\nmm\nAP"
        }
      ],
      "left": [
        {
          "id": "joshjal.menu"
        },
        {
          "id": "omarchy.workspaces"
        },
        {
          "classIconOverrides": {
            "com.t3tools.T3Code": "t3code"
          },
          "id": "joshjal.taskbar",
          "includeSpecial": true,
          "previewDelay": 320
        }
      ],
      "right": [
        {
          "id": "omarchy.tray"
        },
        {
          "id": "omarchy.keyboard-layout"
        },
        {
          "id": "omarchy.tailscale"
        },
        {
          "id": "proton-vpn",
          "type": "command",
          "exec": "~/.config/omarchy/bar/scripts/proton-status",
          "interval": 10,
          "onClick": "setsid -f protonvpn-app"
        },
        {
          "id": "localsend",
          "type": "command",
          "exec": "~/.config/omarchy/bar/scripts/localsend-status",
          "interval": 3,
          "onClick": "omarchy-launch-or-focus localsend_app 'localsend'",
          "onRightClick": "pkill -x localsend"
        },
        {
          "id": "joshjal.agents"
        },
        {
          "id": "omarchy.bluetooth"
        },
        {
          "id": "omarchy.network"
        },
        {
          "id": "omarchy.audio"
        },
        {
          "exec": "~/.config/omarchy/bar/scripts/cpu-status",
          "id": "cpu",
          "interval": 5,
          "onClick": "omarchy-launch-or-focus-tui btop",
          "type": "command"
        },
        {
          "id": "omarchy.monitor"
        },
        {
          "id": "omarchy.power"
        }
      ],
      "centerBegin": [
        {
          "id": "omarchy.indicators"
        }
      ],
      "centerEnd": [
        {
          "id": "omarchy.elsewhen",
          "cities": [
            {
              "name": "New York",
              "zone": "America/New_York"
            },
            {
              "name": "London",
              "zone": "Europe/London"
            },
            {
              "name": "Dubai",
              "zone": "Asia/Dubai"
            },
            {
              "name": "Tokyo",
              "zone": "Asia/Tokyo"
            },
            {
              "name": "Los Angeles",
              "zone": "America/Los_Angeles"
            }
          ]
        },
        {
          "id": "omarchy.weather"
        },
        {
          "id": "omarchy.system-update"
        }
      ]
    },
    "position": "top",
    "transparent": false
  },
  "cloneSourceRestores": [
    "joshjal.notifications",
    "joshjal.menu"
  ],
  "disabledPlugins": [
    "omarchy.notifications",
    "omarchy.menu"
  ],
  "idle": {
    "lock": 3600,
    "screensaver": 1800
  },
  "plugins": [
    {
      "id": "joshjal.notifications"
    }
  ],
  "version": 1
}
